{
  "openapi": "3.1.1",
  "info": {
    "title": "GameLab.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5218/"
    }
  ],
  "paths": {
    "/weatherforecast": {
      "get": {
        "tags": [
          "GameLab.Api"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    },
