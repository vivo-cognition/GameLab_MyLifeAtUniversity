        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameActionDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GameActionDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GameActionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
