    "/api/Game/submit-attestation": {
      "post": {
        "tags": [
          "Game"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerDto"
              }
            },
            "application/*+json": {
              "schema": {
