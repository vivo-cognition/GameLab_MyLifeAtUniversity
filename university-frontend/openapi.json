          }
        }
      }
    },
    "/api/Game/{studentId}/attestation/question/{subjectId}": {
      "get": {
        "tags": [
          "Game"
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
